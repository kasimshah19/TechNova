{
  "name": "tech-nova",
  "version": "1.0.0",
  "private": true,
  "description": "TechNova — AI Tech News & Content Generation Platform (Monorepo)",
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "concurrently -n frontend,backend -c cyan,yellow \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
